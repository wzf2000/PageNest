{
  "name": "pagenest",
  "private": true,
  "scripts": {
    "format": "node tools/format.cjs --write",
    "format:check": "node tools/format.cjs --check",
    "build": "python3 build-assets.py",
    "package": "python3 tools/package.py",
    "test": "php tests/i18n.php && php tests/login.php && php tests/product.php && php tests/appearance.php && php tests/fonts.php && php tests/presentation.php && php tests/category-listing.php && php tests/regions.php && php tests/verify-theme.php && python3 -m unittest discover -s tests -p \"test_*.py\" && npm run i18n:check",
    "test:frontend": "playwright test",
    "test:series-browser": "playwright test --config tests/series-playwright.config.cjs",
    "package:check": "python3 tools/release.py --check-package",
    "identity:check": "python3 tools/identity_scan.py",
    "i18n": "python3 tools/i18n.py",
    "i18n:check": "python3 tools/i18n.py --check",
    "test:reader-ux-webkit": "playwright test --config tests/reader-ux-playwright.config.cjs"
  },
  "devDependencies": {
    "@prettier/plugin-php": "0.25.0",
    "js-beautify": "1.15.4",
    "mdast-util-from-markdown": "2.0.3",
    "pangu": "10.1.1",
    "prettier": "3.9.6",
    "@playwright/test": "1.55.1"
  },
  "version": "1.7.1",
  "license": "GPL-2.0-or-later"
}
